generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  image        String?
  passwordHash String?
  createdAt    DateTime         @default(now())
  senders      Sender[]
  emailJobs    EmailJob[]
  slack        SlackConnection?
}

model Sender {
  id           String     @id @default(cuid())
  userId       String
  email        String
  name         String?
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  hourlyLimit  Int        @default(30)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         EmailJob[]

  @@unique([userId, email])
  @@index([userId])
}

model EmailJob {
  id             String      @id @default(cuid())
  userId         String
  senderId       String
  to             String
  subject        String
  body           String
  scheduledAt    DateTime
  status         String      @default("SCHEDULED")
  idempotencyKey String      @unique
  providerId     String?
  error          String?
  sentAt         DateTime?
  attempts       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([senderId, status])
  @@index([scheduledAt])
}

model SlackConnection {
  id                 String   @id @default(cuid())
  userId             String   @unique
  teamId             String?
  channelId          String?
  channelName        String?
  incomingWebhookUrl String?
  accessToken        String?
  scope              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
